{% extends 'base.html.twig' %}

{% block title %}Connexion - Médiathèque{% endblock %}

{% block body %}
<div class="login-container" style="max-width: 400px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
    <form method="post" action="{{ path('app_login') }}">
        {% if error %}
            <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 15px; border-radius: 4px;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div style="margin-bottom: 15px;">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
        {% endif %}

        <h1 style="font-size: 24px; margin-bottom: 20px;">Connexion</h1>

        <div style="margin-bottom: 15px;">
            <label for="inputEmail" style="display: block; margin-bottom: 5px;">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;">
        </div>

        <div style="margin-bottom: 15px;">
            <label for="inputPassword" style="display: block; margin-bottom: 5px;">Mot de passe</label>
            <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" style="width: 100%; padding: 10px; background-color: #0066cc; color: white; border: none; border-radius: 4px; font-size: 16px; cursor: pointer;">
            Se connecter
        </button>
    </form>
</div>
{% endblock %}
